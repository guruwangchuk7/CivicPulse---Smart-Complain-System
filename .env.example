# Supabase (used for lib/supabase.ts — currently unused by admin auth; see TODOS.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MySQL connection
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=civic_pulse

# Admin auth
# ADMIN_JWT_SECRET: random string, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# ADMIN_CREDENTIALS: comma-separated "email:bcryptHash" pairs, one per admin.
# Generate a hash with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# Example (do not use these values):
#   ADMIN_CREDENTIALS=admin1@example.com:$2b$10$abc...,admin2@example.com:$2b$10$xyz...
ADMIN_CREDENTIALS=
